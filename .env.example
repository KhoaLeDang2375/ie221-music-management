# Cấu hình PostgreSQL trên Docker (dùng cho DBeaver & FastAPI)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=music_db
POSTGRES_PORT=5432
API_PORT=8000

# Chuỗi kết nối dùng cho Backend (SQLAlchemy + psycopg)
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/music_db

# Bảo mật & JWT (Thay bằng chuỗi ngẫu nhiên bảo mật khi chạy thật)
JWT_SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tích hợp Chatbot AI - Groq Cloud (Để trống nếu chưa cần test API generate-ai)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
